@startuml SteamAssist Domain Model

' Enums
enum LoginStatus {
  LOGGED_IN
  LOGGED_OUT
  STEAM_ID_ONLY
}

enum PermissionType {
  VIEW_FRIENDS_RECOMMENDATIONS
  MANAGE_ACCOUNT
  RATE_GAMES
  BASIC_ACCESS
}

' Classes
class User {
  +userID: String
  +username: String
  +email: String
  +password: String
  +loginStatus: LoginStatus
}

class Game {
  +gameID: String
  +title: String
  +description: String
  +releaseDate: Date
  +developer: String
  +publisher: String
  +genre: List<String>
  +tags: List<String>
  +baseGameLength: Integer
  +postgameLength: Integer
  +currentPrice: Float
  +discountPercentage: Float
  +storeURL: String
}

class UserGameData {
  +playtime: Integer
  +lastPlayed: Date
  +isOwned: Boolean
  +isCompleted: Boolean
  +rating: Integer
}

class GameRecommendation {
  +recommendationScore: Float
  +recommendationReason: String
}

class RecommendationFilter {
  +maxPrice: Float
  +minRating: Float
  +genres: List<String>
  +tags: List<String>
  +maxGameLength: Integer
  +excludeOwned: Boolean
  +onlyDiscounted: Boolean
}

class GameReview {
  +reviewID: String
  +rating: Integer
  +reviewText: String
  +reviewDate: Date
  +helpfulVotes: Integer
}

class FriendRecommendation {
  +recommendationMessage: String
  +recommendationDate: Date
  +isAccepted: Boolean
}

class GamePage {
  +averageRating: Float
}

class Permission {
  +type: PermissionType
  +description: String
}

' Relationships
User "1" -- "0..*" UserGameData : has >
User "1" -- "0..*" GameReview : writes >
User "1" -- "0..*" FriendRecommendation : sends >
User "1" -- "0..*" FriendRecommendation : receives <
Game "1" -- "0..*" UserGameData : tracked in >
Game "1" -- "0..*" GameReview : has >
Game "1" -- "0..*" GameRecommendation : is recommended as >
Game "1..*" -- "0..*" GameRecommendation : is source for >
RecommendationFilter "0..1" -- "0..*" GameRecommendation : refines >
User "1" -- "1..*" Permission : has >
GamePage "1" -- "1" Game : displays >
GamePage "1" -- "0..*" GameReview : shows >
LoginStatus "1" -- "0..*" Permission : determines >
User "1" -- "0..*" User : friends with >

@enduml
